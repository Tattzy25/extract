{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "extract",
	"main": "src/index.ts",

	// REQUIRED >= 2026-03-24 for env.BROWSER.quickAction()
	"compatibility_date": "2026-03-24",
	"compatibility_flags": ["nodejs_compat"],

	"observability": { "enabled": true },

	// Bind the Worker to the real hostname. Bazaar down-ranks *.workers.dev.
	// This replaces any proxied DNS record for extract.anigok.com.
	"routes": [
		{
			"pattern": "extract.anigok.com",
			"custom_domain": true
		}
	],

	"assets": {
		"directory": "public",
		"binding": "ASSETS"
	},

	// Browser Run. "remote": true is required for quickAction() during `wrangler dev`.
	"browser": {
		"binding": "BROWSER",
		"remote": true
	},

	"durable_objects": {
		"bindings": [
			{
				"name": "EXTRACT_MCP",
				"class_name": "ExtractMcp"
			}
		]
	},

	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["ExtractMcp"]
		}
	],

	// Weekly self-payment keeps the Bazaar listing from being delisted at 30 days.
	// No-ops unless the BUYER_PRIVATE_KEY secret is set.
	"triggers": {
		"crons": ["0 12 * * 1"]
	},

	"vars": {
		// Base mainnet, CAIP-2. USDC is resolved automatically by @x402/evm.
		"NETWORK": "eip155:8453",
		"PRICE": "$0.01",

		// >>> REPLACE with your own receiving address before deploying. <<<
		"PAY_TO": "0x0000000000000000000000000000000000000000",

		"SERVICE_ORIGIN": "https://extract.anigok.com",
		"SERVICE_NAME": "extract"
	}

	// Secrets (never in this file — set with `wrangler secret put`):
	//   CDP_API_KEY_ID
	//   CDP_API_KEY_SECRET
	//   BUYER_PRIVATE_KEY   (optional, only for the cron keepalive)
}
